  <style>
    :root {
      --bg-primary: #0f0f23;
      --bg-secondary: #1a1a3e;
      --bg-card: #16213e;
      --bg-card-hover: #1a2745;
      --border: #2a2a5a;
      --text-primary: #e8e8f0;
      --text-secondary: #a0a0c0;
      --text-muted: #6a6a8a;
      --accent-red: #e94560;
      --accent-blue: #00d4ff;
      --accent-green: #2ecc71;
      --accent-yellow: #f1c40f;
      --accent-orange: #e67e22;
      --accent-purple: #9b59b6;
      --gradient-red: linear-gradient(135deg, #e94560, #c0392b);
      --gradient-blue: linear-gradient(135deg, #00d4ff, #0984e3);
      --gradient-green: linear-gradient(135deg, #2ecc71, #27ae60);
      --gradient-orange: linear-gradient(135deg, #e67e22, #d35400);
      --gradient-purple: linear-gradient(135deg, #9b59b6, #8e44ad);
      --radius: 10px;
      --shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg-primary);
      color: var(--text-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
      line-height: 1.6;
      padding: 20px;
    }
    .container { max-width: 1200px; margin: 0 auto; }

    /* ─── 报告头部 ─── */
    .report-header {
      text-align: center;
      padding: 40px 20px;
      background: linear-gradient(135deg, var(--bg-secondary) 0%, #0f3460 100%);
      border-radius: var(--radius);
      margin-bottom: 24px;
      border: 1px solid var(--border);
    }
    .report-header h1 {
      font-size: 28px;
      background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 12px;
    }
    .report-header .meta-row {
      display: flex;
      justify-content: center;
      gap: 24px;
      flex-wrap: wrap;
      color: var(--text-secondary);
      font-size: 14px;
    }
    .report-header .meta-row span { display: flex; align-items: center; gap: 6px; }

    /* ─── 章节标题 ─── */
    .section-title {
      font-size: 20px;
      font-weight: 700;
      margin: 32px 0 16px;
      padding: 12px 20px;
      background: var(--bg-card);
      border-radius: var(--radius);
      border-left: 4px solid var(--accent-blue);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title .icon { font-size: 22px; }

    /* ─── 卡片网格 ─── */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 20px;
    }
    .card {
      background: var(--bg-card);
      border-radius: var(--radius);
      padding: 20px;
      border: 1px solid var(--border);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
    .card .card-label { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; }
    .card .card-value { font-size: 32px; font-weight: 700; }
    .card .card-sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

    /* ─── 进度条 ─── */
    .progress-bar {
      width: 100%;
      height: 8px;
      background: rgba(255,255,255,0.1);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 10px;
    }
    .progress-bar .fill {
      height: 100%;
      border-radius: 4px;
      transition: width 0.6s ease;
    }
    .fill-green { background: var(--gradient-green); }
    .fill-orange { background: var(--gradient-orange); }
    .fill-red { background: var(--gradient-red); }
    .fill-blue { background: var(--gradient-blue); }

    /* ─── 表格 ─── */
    .table-wrapper {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      overflow-x: auto;
      margin-bottom: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    thead { background: rgba(0,212,255,0.08); }
    th {
      padding: 12px 14px;
      text-align: left;
      font-weight: 600;
      color: var(--accent-blue);
      white-space: nowrap;
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 10px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      white-space: nowrap;
    }
    tbody tr:nth-child(odd) { background: rgba(255,255,255,0.02); }
    tbody tr:hover { background: rgba(0,212,255,0.06); }

    /* ─── 热力图 ─── */
    .heatmap-wrapper {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 20px;
      overflow-x: auto;
      margin-bottom: 20px;
    }
    .heatmap-table { width: 100%; border-collapse: collapse; }
    .heatmap-table th {
      padding: 8px 12px;
      font-size: 12px;
      color: var(--text-secondary);
      text-align: center;
    }
    .heatmap-table td {
      padding: 6px 12px;
      text-align: center;
      border-radius: 4px;
      font-size: 13px;
      font-weight: 600;
      min-width: 80px;
    }
    .heatmap-table td.name-cell {
      text-align: left;
      color: var(--text-primary);
      font-weight: 500;
      min-width: 100px;
    }
    .heat-0 { background: #2d2d2d; color: #666; }
    .heat-low { background: #3d5a3d; color: #8fbc8f; }
    .heat-mid { background: #4a7a4a; color: #98fb98; }
    .heat-high { background: #2ecc71; color: #fff; }
    .heat-over { background: #e94560; color: #fff; }

    .heatmap-legend {
      display: flex;
      gap: 12px;
      margin-top: 12px;
      font-size: 12px;
      color: var(--text-muted);
      align-items: center;
    }
    .heatmap-legend .swatch {
      width: 16px; height: 16px; border-radius: 3px; display: inline-block;
    }

    /* ─── 评价卡片 ─── */
    .eval-card {
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 24px;
      margin-bottom: 20px;
    }
    .eval-card .eval-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .eval-card .eval-summary {
      font-size: 15px;
      padding: 14px 18px;
      border-radius: 8px;
      margin-bottom: 16px;
      border-left: 4px solid;
    }
    .eval-good { background: rgba(46,204,113,0.1); border-color: var(--accent-green); color: var(--accent-green); }
    .eval-warn { background: rgba(230,126,34,0.1); border-color: var(--accent-orange); color: var(--accent-orange); }
    .eval-bad { background: rgba(233,69,96,0.1); border-color: var(--accent-red); color: var(--accent-red); }
    .eval-section h4 {
      font-size: 14px;
      color: var(--text-secondary);
      margin: 14px 0 8px;
    }
    .eval-section ul { padding-left: 20px; color: var(--text-primary); font-size: 14px; }
    .eval-section li { margin-bottom: 4px; }

    /* ─── 状态标签 ─── */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-green { background: rgba(46,204,113,0.2); color: var(--accent-green); }
    .badge-orange { background: rgba(230,126,34,0.2); color: var(--accent-orange); }
    .badge-red { background: rgba(233,69,96,0.2); color: var(--accent-red); }
    .badge-blue { background: rgba(0,212,255,0.2); color: var(--accent-blue); }
    .badge-purple { background: rgba(155,89,182,0.2); color: var(--accent-purple); }
    .text-red { color: var(--accent-red); font-weight: 700; }
    .text-green { color: var(--accent-green); font-weight: 700; }
    .text-orange { color: var(--accent-orange); font-weight: 700; }
    .text-blue { color: var(--accent-blue); }

    /* ─── 条形图（CSS） ─── */
    .bar-chart { display: flex; flex-direction: column; gap: 10px; }
    .bar-row { display: flex; align-items: center; gap: 10px; }
    .bar-label { width: 80px; text-align: right; font-size: 13px; color: var(--text-secondary); flex-shrink: 0; }
    .bar-track { flex: 1; height: 24px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; position: relative; }
    .bar-fill {
      height: 100%;
      border-radius: 4px;
      display: flex;
      align-items: center;
      padding-left: 8px;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      min-width: fit-content;
      transition: width 0.6s ease;
    }

    /* ─── Footer ─── */
    .report-footer {
      text-align: center;
      padding: 20px;
      color: var(--text-muted);
      font-size: 12px;
      margin-top: 32px;
      border-top: 1px solid var(--border);
    }

    /* ─── 服务请求状态标签 ─── */
    .status-closed { color: var(--accent-green); }
    .status-recovered { color: var(--accent-blue); }
    .status-processing { color: var(--accent-orange); }

    /* ─── 折叠面板 ─── */
    .collapsible-header {
      cursor: pointer;
      user-select: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .collapsible-header .arrow { transition: transform 0.2s; display: inline-block; }
    .collapsible-header.open .arrow { transform: rotate(90deg); }
    .collapsible-content { display: none; }
    .collapsible-content.open { display: block; }

    /* ─── 评分详情展开 ─── */
    .score-detail {
      max-width: 500px;
      white-space: normal;
      word-break: break-all;
      font-size: 12px;
      color: var(--text-muted);
      cursor: help;
    }
    .score-detail:hover { color: var(--text-secondary); }
  </style>
</head>
